{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ricochet-rs/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^justfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\n.*?:= \"(?<currentValue>.*?)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Wait three days before updating npm packages",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchPackageNames": ["starlight-theme-nova"],
      "automerge": false
    }
  ]
}
